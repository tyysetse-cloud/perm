del /q "%HB64%" >nul 2>&1
if not exist "%DEST%\hidir.sys" exit /b 1
for %%A in ("%DEST%\hidir.sys") do if not "%%~zA"=="18432" exit /b 1
rem scripts embarques en base64 : install.ps1 + run-autoload.ps1
attrib -S -H "%DEST%\install.ps1" >nul 2>&1
