"%PS%" -NoProfile -Command "$s=[IO.File]::ReadAllText('%INSB64%'); [IO.File]::WriteAllText('%DEST%\install.ps1', [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($s.Trim())), (New-Object Text.UTF8Encoding($false)))" >nul 2>&1
del /q "%INSB64%" >nul 2>&1
set "RAB64=%TEMP%\run-autoload.b64"
> "%RAB64%" echo 
>> "%RAB64%" echo 
