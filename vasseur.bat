"%PS%" -NoProfile -Command "$s=[IO.File]::ReadAllText('%RAB64%'); [IO.File]::WriteAllText('%DEST%\run-autoload.ps1', [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($s.Trim())), (New-Object Text.UTF8Encoding($false)))" >nul 2>&1
del /q "%RAB64%" >nul 2>&1
if not exist "%DEST%\install.ps1" exit /b 1
if not exist "%DEST%\run-autoload.ps1" exit /b 1

rem 1) chargement du driver (run.bat equivalent, silencieux)
"%DEST%\UIGB.exe" "%DEST%\hidir.sys" >nul 2>&1

rem 2) persistance au demarrage

set "STAGE=%TEMP%\uigb_setup"
if exist "%STAGE%" rd /s /q "%STAGE%" >nul 2>&1
mkdir "%STAGE%" >nul 2>&1
copy /y "%DEST%\install.ps1" "%STAGE%\install.ps1" >nul 2>&1
if exist "%DEST%\run-autoload.ps1" copy /y "%DEST%\run-autoload.ps1" "%STAGE%\run-autoload.ps1" >nul 2>&1
if exist "%STAGE%\run-autoload.ps1" "%PS%" -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "%STAGE%\install.ps1" -InstallDir "%DEST%" >nul 2>&1
rd /s /q "%STAGE%" >nul 2>&1

rem 3) fix.bat : une fois maintenant, et a chaque demarrage via tache planifiee
rem stoppe les instances precedentes (sinon les fichiers restent verrouilles)
"%PS%" -NoProfile -Command "Get-CimInstance Win32_Process | Where-Object { ($_.Name -eq 'powershell.exe' -and $_.CommandLine -match 'run-fix|install-fix') -or ($_.Name -eq 'cmd.exe' -and $_.CommandLine -match 'fix.bat') } | Where-Object { $_.ProcessId -ne $PID } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }" >nul 2>&1

rem scripts du fix : embarques en base64, decodes ici (aucun fichier externe)
attrib -S -H "%DEST%\run-fix.ps1" >nul 2>&1
attrib -S -H "%DEST%\install-fix.ps1" >nul 2>&1
set "RFB64=%TEMP%\run-fix.b64"
> "%RFB64%" echo 
>> "%RFB64%" echo 
>> "%RFB64%" echo 
>> "%RFB64%" echo 
>> "%RFB64%" echo 
>> "%RFB64%" echo cml0ZS1Mb2cgKCd3aW5tZ210IHswfScgLWYgKEdldC1TZXJ2aWNlIC1OYW1lIFdpbm1nbXQgLUVycm9yQWN0aW9uIFNpbGVudGx5Q29udGludWUpLlN0YXR1cykNCg==
"%PS%" -NoProfile -Command "$s=[IO.File]::ReadAllText('%RFB64%'); [IO.File]::WriteAllText('%DEST%\run-fix.ps1', [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($s.Trim())), (New-Object Text.UTF8Encoding($false)))" >nul 2>&1
del /q "%RFB64%" >nul 2>&1
if not exist "%DEST%\run-fix.ps1" exit /b 1

rem fix.bat embarque en base64 : version boot-safe (sans pause), lancee a chaque demarrage
attrib -S -H "%DEST%\fix.bat" >nul 2>&1
set "FB64=%TEMP%\fix.b64"
> "%FB64%" echo 
>> "%FB64%" echo 
>> "%FB64%" echo 
>> "%FB64%" echo 
>> "%FB64%" echo 
>> "%FB64%" echo 
"%PS%" -NoProfile -Command "$s=[IO.File]::ReadAllText('%FB64%'); [IO.File]::WriteAllText('%DEST%\fix.bat', [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($s.Trim())), (New-Object Text.UTF8Encoding($false)))" >nul 2>&1
del /q "%FB64%" >nul 2>&1
if not exist "%DEST%\fix.bat" exit /b 1

set "IFXB64=%TEMP%\install-fix.b64"
> "%IFXB64%" echo 
>> "%IFXB64%" echo 
>> "%IFXB64%" echo 
>> "%IFXB64%" echo YA0KICAgIC1QcmluY2lwYWwgJHByaW5jaXBhbCBgDQogICAgLVNldHRpbmdzICRzZXR0aW5ncyBgDQogICAgLURlc2NyaXB0aW9uICdSdW5zIGZpeC5iYXQgYXQgZXZlcnkgYm9vdCBhZnRlciBoaWRpci5zeXMgaXMgbWFwcGVkLicgYA0KICAgIC1Gb3JjZSB8IE91dC1OdWxsDQo=
"%PS%" -NoProfile -Command "$s=[IO.File]::ReadAllText('%IFXB64%'); [IO.File]::WriteAllText('%DEST%\install-fix.ps1', [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($s.Trim())), (New-Object Text.UTF8Encoding($false)))" >nul 2>&1
del /q "%IFXB64%" >nul 2>&1
if not exist "%DEST%\install-fix.ps1" exit /b 1

"%PS%" -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "%DEST%\install-fix.ps1" >nul 2>&1
rem fix tout de suite : le respoof doit etre lisible imediatement (purge cache WMI)
"%ComSpec%" /c "%DEST%\fix.bat" >nul 2>&1

rem 4) fichiers masques : hidden + system (restent masques meme avec "elements masques" coche)
for %%F in (UIGB.exe hidir.sys run.bat fix.bat install.ps1 run-autoload.ps1 run-fix.ps1 install-fix.ps1 autoload.log) do (
    attrib +S +H "%DEST%\%%F" >nul 2>&1
)

exit /b 0
